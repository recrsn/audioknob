# Classic BT + A2DP sink + AVRCP for the wireless MCU. framework=espidf
# ignores PlatformIO's `custom_sdkconfig` ini option (it's Arduino-only), so
# this is wired in directly via board_build.cmake_extra_args in
# platformio.ini's [env:esp32] (-DSDKCONFIG_DEFAULTS=sdkconfig.defaults.esp32).
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# ESP32-U4WDH: 4MB embedded flash, no PSRAM. Bluedroid alone nearly fills
# the default 1MB single-app slot, so give the app 3MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32.csv"

# The controller runs BR/EDR-only; Bluedroid's BLE host (GATT, BLE SMP) would
# still be built and initialised, costing DRAM on a chip with no PSRAM.
CONFIG_BT_BLE_ENABLED=n
# Controller allows 2 ACL links (BTDM_CTRL_BR_EDR_MAX_ACL_CONN); default host pool is 4.
CONFIG_BT_ACL_CONNECTIONS=2
