# ESP32-S3R8 on this board: 16MB flash, 8MB octal PSRAM (spec.md §6). Wired
# in via board_build.cmake_extra_args in platformio.ini's [env:s3], same as
# sdkconfig.defaults.esp32.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_s3.csv"
# Firmware updates arrive over WiFi (ota.c). An updated image that never
# gets its web server up is rolled back on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Radio task stacks use PSRAM; both tasks only read flash.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# Keep WiFi/lwIP buffers out of internal RAM; the LCD/I2S DMA needs it.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 1 ms ticks so the AirPlay player can wake close to a frame's playtime.
CONFIG_FREERTOS_HZ=1000

# AirPlay 2: RTSP listener + 2 sessions, event port, PTP x2, NTP, RTP data
# and control (or buffered TCP), DACP; plus mDNS, SNTP, the settings page
# and HTTPS.
CONFIG_LWIP_MAX_SOCKETS=24

# ntp.c takes NTP servers from DHCP when the router offers them.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# AirPlay sends a packet every 8 ms and WiFi delivers them in A-MPDU bursts;
# the default 6-slot UDP queue drops audio, which snowballs into resend storms.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# Internal RAM is for what needs speed (DMA, task stacks); the rest goes to
# PSRAM. AirPlay's RSA handshake (once per session) and mDNS data don't.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# Its task only answers queries and sends adverts: nothing timing-critical,
# and it never writes flash.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y

# -Og left LVGL's software renderer ~1.5x slower; page swipes redraw the
# whole screen every frame.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The board's Boya flash does QIO; DIO halves code/rodata fetch bandwidth on
# every cache miss.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# 64-byte D-cache lines halve the misses when streaming PSRAM (full-screen
# image blits: the wallpaper and page-swipe snapshots) at no RAM cost.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
